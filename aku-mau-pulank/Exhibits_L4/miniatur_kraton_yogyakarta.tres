[sub_resource type="Resource" id="Resource_t2"]
script = ExtResource("3_tt")
kalimat = "Tugu Yogyakarta berdiri di sisi utara kraton."
kata_kunci = "Tugu"

[resource]
script = ExtResource("1_karya")
id = &"kraton_yogyakarta"
tipe = 0
judul = "Miniatur Kraton Yogyakarta"
era = "Kesultanan Yogyakarta"
teks_label = "Kraton Yogyakarta berdiri setelah Perjanjian Giyanti pada [b]1755[/b] membagi Kerajaan Mataram. Pangeran Mangkubumi, yang bergelar Sultan Hamengkubuwana I, mulai menempati kraton pada [b]1756[/b]. Pada [b]1945[/b], Sri Sultan Hamengkubuwana IX menyatakan Yogyakarta bergabung dengan Republik Indonesia melalui sebuah maklumat. Kraton ditata menurut filosofi Jawa dan masih menjadi tempat tinggal sultan. Banyak wisatawan datang untuk mengenal seni dan tradisi istana."
fakta = Array[ExtResource("2_fakta")]([SubResource("Resource_f1"), SubResource("Resource_f2"), SubResource("Resource_f3")])
tak_terbukti = Array[ExtResource("3_tt")]([SubResource("Resource_t1"), SubResource("Resource_t2")])
