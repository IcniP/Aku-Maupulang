[ext_resource type="Script" path="res://Code/SejarahTakTerbuktiData.gd" id="3_tt"]

[sub_resource type="Resource" id="Resource_f1"]
script = ExtResource("2_fakta")
id = &"kraton_giyanti"
tahun = 1755
kata_kunci = "Giyanti"
kalimat_benar = "Perjanjian Giyanti pada 1755 membagi Kerajaan Mataram."
varian_salah = PackedStringArray("Perjanjian Giyanti pada 1775 membagi Kerajaan Mataram.", "Perjanjian Giyanti pada 1755 menyatukan kembali seluruh Kerajaan Mataram.")

[sub_resource type="Resource" id="Resource_f2"]
script = ExtResource("2_fakta")
id = &"kraton_mangkubumi"
tahun = 1756
kata_kunci = "Mangkubumi"
kalimat_benar = "Pangeran Mangkubumi mulai menempati Kraton Yogyakarta pada 1756."
varian_salah = PackedStringArray("Pangeran Mangkubumi mulai menempati Kraton Yogyakarta pada 1856.", "Pakubuwana III mulai menempati Kraton Yogyakarta pada 1756.")

[sub_resource type="Resource" id="Resource_f3"]
script = ExtResource("2_fakta")
id = &"kraton_maklumat"
tahun = 1945
kata_kunci = "maklumat"
kalimat_benar = "Pada 1945, Sultan Hamengkubuwana IX menyatakan Yogyakarta bergabung dengan Republik Indonesia melalui sebuah maklumat."
varian_salah = PackedStringArray("Pada 1950, Sultan Hamengkubuwana IX menyatakan Yogyakarta bergabung dengan Republik Indonesia melalui sebuah maklumat.", "Pada 1945, Sultan Hamengkubuwana IX menyatakan Yogyakarta tetap terpisah dari Republik Indonesia melalui sebuah maklumat.")

